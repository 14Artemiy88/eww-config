#!/bin/bash
# Get top applications by memory usage
# Returns JSON array of {name, value} objects

ps -eo comm,%mem --sort=-%mem | head -6 | tail -5 | while read name mem; do
    # Extract just the numeric part and format properly
    mem_num=$(echo "$mem" | grep -oE '[0-9]+\.?[0-9]*' | head -1)
    if [ -n "$mem_num" ]; then
        printf '{"name":"%s","value":"%.1f%%"}\n' "$name" "$mem_num"
    fi
done | jq -s '.'


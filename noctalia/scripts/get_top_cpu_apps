#!/bin/bash
# Get top applications by CPU usage
# Returns JSON array of {name, value} objects

ps -eo comm,%cpu --sort=-%cpu | head -6 | tail -5 | while read name cpu; do
    # Extract just the numeric part and format properly
    cpu_num=$(echo "$cpu" | grep -oE '[0-9]+\.?[0-9]*' | head -1)
    if [ -n "$cpu_num" ]; then
        printf '{"name":"%s","value":"%.1f%%"}\n' "$name" "$cpu_num"
    fi
done | jq -s '.'


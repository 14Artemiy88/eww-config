// Noctalia Widget Configuration - Top Apps by CPU and Memory Usage
// Ported from eww config

// ============================================
// Top Applications Widget
// ============================================
widget top_apps_widget {
    type: "box"
    class: ["topstuff"]
    orientation: "vertical"
    space-evenly: false
    
    children: [
        // Top apps by CPU usage
        {
            type: "apps_list"
            class: ["top_app"]
            title: "CPU"
            values: { source: "top_cpu_apps", interval: "2s" }
        },
        // Top apps by memory usage
        {
            type: "apps_list"
            class: ["top_app"]
            title: "MEM"
            values: { source: "top_mem_apps", interval: "2s" }
        }
    ]
}

// ============================================
// Data Sources
// ============================================

// Top applications by CPU usage
source top_cpu_apps {
    type: "script"
    command: "scripts/get_top_cpu_apps"
    interval: "2s"
    output_format: "json_array"
}

// Top applications by memory usage
source top_mem_apps {
    type: "script"
    command: "scripts/get_top_mem_apps"
    interval: "2s"
    output_format: "json_array"
}

// ============================================
// Helper Components
// ============================================

component apps_list [values, title, class] {
    type: "box"
    class: ["stuff", class]
    halign: "start"
    orientation: "vertical"
    hexpand: false
    
    children: [
        // Iterate through app entries
        for entry in values {
            type: "box"
            
            children: [
                {
                    type: "label"
                    class: ["name"]
                    halign: "start"
                    text: entry.name
                    limit_width: 60
                },
                {
                    type: "label"
                    class: ["value"]
                    halign: "end"
                    text: entry.value
                }
            ]
        }
    ]
}

